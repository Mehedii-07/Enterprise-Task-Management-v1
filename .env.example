# =================================================================
# Enterprise Task Manager SaaS - Production Environment Configuration
# =================================================================
# Copy this file to .env and replace all default passwords/keys before deploying:
#   cp .env.example .env

# Database Configuration (PostgreSQL)
POSTGRES_DB=enterprise_task_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_strong_password_here

# JWT & Security Secrets
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_a_secure_random_hex_32_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Mode
ENVIRONMENT=production
DEBUG=False

# Default Super Admin CEO Credentials
SUPER_ADMIN_EMAIL=ceo@enterprise.com
SUPER_ADMIN_PASSWORD=SetAStrongCeoPassword123!
